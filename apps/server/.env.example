# LLM Provider
# OpenAI:    set OPENAI_API_KEY=sk-...
# DeepSeek:  set DEEPSEEK_API_KEY=sk-...
PROVIDER=deepseek
MODEL=deepseek-v4-flash

# Database
SQLITE_PATH=../../data/fanto.sqlite

# Embedding
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
EMBEDDING_MODEL=text-embedding-v2
EMBEDDING_DIMENSION=1536

# Server
PORT=3000
HOST=0.0.0.0

# Scheduler
ORGANIZER_TRIGGER_CRON=*/5 * * * *
